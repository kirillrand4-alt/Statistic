# ---------------------------------------------------------------------------
# Statistic — SEO analytics service. Copy to .env and fill in your values.
# ---------------------------------------------------------------------------

APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/seo.db        # or postgresql+psycopg://user:pass@host/db
TIMEZONE=Europe/Moscow
# Serve under a subpath behind a reverse proxy, e.g. /stat. Empty = root (or subdomain).
ROOT_PATH=
# Public base URL for OAuth redirects (e.g. https://parsercompressor.online).
# Leave empty to derive from the request (Host + X-Forwarded-Proto).
PUBLIC_BASE_URL=
# Max size (MB) of a single uploaded file / form field (big phrase/URL pastes,
# Metrika CSV). Starlette's default is 1 MB per part.
MAX_UPLOAD_MB=64

# ---- Google Search Console ----
# Auth mode: "service_account" (recommended) or "oauth"
GSC_AUTH_MODE=service_account
# Service-account JSON key file (download from Google Cloud Console).
# IMPORTANT: add the service-account email as a USER on the property in
# Search Console (Settings -> Users and permissions), otherwise you get 403.
GSC_SERVICE_ACCOUNT_FILE=./secrets/gsc-sa.json
# OAuth fallback (only used when GSC_AUTH_MODE=oauth):
GSC_OAUTH_CLIENT_FILE=./secrets/gsc-oauth-client.json
GSC_OAUTH_REFRESH_TOKEN=
# Default property to register on first run. URL-prefix or domain property:
#   sc-domain:example.com   OR   https://example.com/
GSC_SITE_URL=
GSC_DATA_DELAY_DAYS=3

# ---- Yandex Webmaster (Phase 2) ----
YANDEX_WM_OAUTH_TOKEN=
YANDEX_WM_USER_ID=
YANDEX_WM_HOST_ID=

# ---- Yandex Metrika (Phase 3) ----
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# ---- Scheduler ----
ENABLE_SCHEDULER=true
COLLECT_CRON_HOUR=4
COLLECT_REFETCH_DAYS=5
